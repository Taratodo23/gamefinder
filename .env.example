# Firebase (configuración web pública: se incorpora al navegador)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# RAWG: SIN prefijo VITE_ para que nunca llegue al navegador.
# La usa solo la función /api/rawg (Vercel) y el proxy de desarrollo de Vite.
RAWG_API_KEY=

# true = usar datos de prueba (src/mocks) en lugar de RAWG
VITE_USE_MOCK_DATA=false
