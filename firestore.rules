rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function esDueno(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Forma válida de un juego guardado en la biblioteca.
    function juegoValido(d, gameId) {
      return d.keys().hasOnly(['gameId', 'title', 'cover', 'status', 'rating', 'note', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['gameId', 'title', 'cover', 'status', 'rating', 'note', 'createdAt', 'updatedAt'])
        && d.gameId is int && string(d.gameId) == gameId
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && (d.cover == null || (d.cover is string && d.cover.size() <= 500))
        && d.status in ['pendiente', 'jugando', 'completado', 'abandonado']
        && d.rating is int && d.rating >= 0 && d.rating <= 5
        && d.note is string && d.note.size() <= 500
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    // Cada usuario (anónimo) accede solo a su propia biblioteca.
    match /users/{uid}/library/{gameId} {
      allow read, delete: if esDueno(uid);

      allow create: if esDueno(uid)
        && juegoValido(request.resource.data, gameId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Al editar solo cambian estado, puntuación, nota y fecha de actualización.
      allow update: if esDueno(uid)
        && juegoValido(request.resource.data, gameId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'rating', 'note', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
    }

    // Todo lo demás queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
